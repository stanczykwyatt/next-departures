<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Everything Next Departures is allowed to do. The App Sandbox blocks anything not listed here.

	It can open connections out to the internet, which it needs to download transit schedules and
	live departures, and nothing else: no files outside its own container, no camera, microphone,
	location, contacts or Apple Events, and it can't accept incoming connections. Which hosts it
	connects to is decided in Sources/TransitCore/Fetcher.swift: only those of the feeds you use.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
